{
  "id": "tunnels",
  "name": "Tunnels",
  "version": "1.2.2",
  "description": "SSH port forwarding that reconnects on its own, WireGuard gateways that publish private services, and client tunnels from the desktop app.",
  "author": {
    "name": "Termix"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/Termix-SSH/Plugin-Tunnels",
  "docs": "https://docs.termix.site/plugins/tunnels",
  "video": "https://www.youtube.com/watch?v=taRk5rpu0EA",
  "category": "Networking",
  "icon": "ArrowLeftRight",
  "features": [
    "Local, remote and dynamic SOCKS5 forwarding",
    "Reconnects on its own when a tunnel drops",
    "Start tunnels on boot",
    "Route a tunnel through a second host",
    "WireGuard gateways that forward public ports to services on a private host",
    "Finds listening ports on its own, with a switch for each one",
    "Client tunnels on your own computer from the desktop app, with presets you can save to the server",
    "A tunnels panel beside any SSH terminal and a tunnels dashboard card"
  ],
  "engine": {
    "termix": ">=26.10.3",
    "api": "^1.5"
  },
  "capabilities": [
    "hosts:read",
    "credentials:use",
    "ssh:connect",
    "db:own",
    "network:serve",
    "ui:surface",
    "users:impersonate",
    "db:core-refs",
    "desktop:local",
    "secrets:own"
  ],
  "provides": [
    {
      "service": "tunnels.access",
      "version": "1.0.0",
      "permission": "tunnels.use"
    }
  ],
  "contributes": {
    "tabs": [
      {
        "id": "tunnel",
        "titleKey": "nav.tunnels",
        "icon": "ArrowLeftRight",
        "openFrom": ["host-context-menu"]
      }
    ],
    "panels": [
      {
        "id": "port-forwarding",
        "titleKey": "nav.portForwarding",
        "icon": "Network"
      }
    ],
    "actions": [
      {
        "id": "tunnels.statuses",
        "titleKey": "nav.tunnels",
        "handler": "statuses",
        "permission": "tunnels.use"
      },
      {
        "id": "tunnels.open",
        "titleKey": "nav.tunnels",
        "handler": "open",
        "permission": "tunnels.use"
      }
    ],
    "permissions": [
      {
        "name": "use",
        "titleKey": "permissions.use.title",
        "descriptionKey": "permissions.use.description",
        "defaultRoles": ["admin", "user"]
      }
    ],
    "settings": {
      "host": {
        "enableKey": "enableTunnel",
        "enableLabelKey": "settings.host.enable.label",
        "enableDescriptionKey": "settings.host.enable.description",
        "fields": [
          {
            "key": "tunnelConnections",
            "labelKey": "hosts.tabTunnels",
            "type": "custom",
            "component": "tunnelConnections",
            "requires": "enableTunnel",
            "defaultable": false,
            "hidden": true
          },
          {
            "key": "showPanel",
            "type": "boolean",
            "labelKey": "settings.host.showPanel.label",
            "descriptionKey": "settings.host.showPanel.description",
            "default": true,
            "requires": "enableTunnel"
          }
        ]
      },
      "user": [
        {
          "key": "companionAutoOpen",
          "type": "boolean",
          "labelKey": "settings.user.companionAutoOpen.label",
          "descriptionKey": "settings.user.companionAutoOpen.description",
          "default": false
        },
        {
          "key": "companionSide",
          "type": "select",
          "labelKey": "settings.user.companionSide.label",
          "descriptionKey": "settings.user.companionSide.description",
          "default": "right",
          "options": [
            {
              "value": "right",
              "labelKey": "settings.user.companionSide.right"
            },
            {
              "value": "left",
              "labelKey": "settings.user.companionSide.left"
            },
            {
              "value": "bottom",
              "labelKey": "settings.user.companionSide.bottom"
            }
          ]
        },
        {
          "key": "companionSize",
          "type": "number",
          "labelKey": "settings.user.companionSize.label",
          "descriptionKey": "settings.user.companionSize.description",
          "min": 240,
          "max": 900,
          "default": 320
        },
        {
          "key": "companionEdgeButton",
          "type": "boolean",
          "labelKey": "settings.user.companionEdgeButton.label",
          "descriptionKey": "settings.user.companionEdgeButton.description",
          "default": true
        }
      ]
    },
    "hostCapability": {
      "key": "enableTunnel",
      "labelKey": "hosts.tabTunnels",
      "editorTab": "general"
    },
    "uiPresets": {
      "simple": {
        "viewMode": "grid",
        "density": "comfortable"
      },
      "balanced": {
        "viewMode": "grid",
        "density": "comfortable"
      },
      "advanced": {
        "viewMode": "list",
        "density": "compact"
      }
    },
    "uses": ["homepage.widgets"],
    "dashboardCards": [
      {
        "id": "tunnels",
        "titleKey": "nav.tunnels",
        "icon": "Network"
      }
    ]
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
